rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function time(id) { return get(/databases/$(database)/documents/times/$(id)).data; }

    // Conta: cada pessoa só lê e salva a própria.
    match /usuarios/{uid} {
      allow read, write: if logado() && eu() == uid;

      // Histórico de partidas: só o dono vê.
      match /partidas/{pid} {
        allow read, write: if logado() && eu() == uid;
      }
    }

    // Times de até 3 pessoas. O código do convite é o id do time.
    match /times/{id} {
      allow get: if logado();
      allow list: if logado() && eu() in resource.data.membros;

      allow create: if logado()
        && request.resource.data.dono == eu()
        && request.resource.data.membros == [eu()]
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 30;

      // Só dá pra entrar (se adicionar) ou sair (se tirar). Máximo de 3.
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
        && request.resource.data.membros.size() <= 3
        && (
          (request.resource.data.membros.toSet().difference(resource.data.membros.toSet()) == [eu()].toSet()
            && resource.data.membros.toSet().difference(request.resource.data.membros.toSet()).size() == 0)
          ||
          (resource.data.membros.toSet().difference(request.resource.data.membros.toSet()) == [eu()].toSet()
            && request.resource.data.membros.toSet().difference(resource.data.membros.toSet()).size() == 0)
        );

      allow delete: if logado() && resource.data.dono == eu();

      // Perfil de cada membro dentro do time (nick, upados, Buffies).
      match /membros/{uid} {
        allow read: if logado() && eu() in time(id).membros;
        allow create, update: if logado() && eu() == uid && eu() in time(id).membros;
        allow delete: if logado() && (eu() == uid || time(id).dono == eu());
      }
    }
  }
}
